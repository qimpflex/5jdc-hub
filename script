            player.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping) 
        end
    end
    
    if _G.TriggerBot and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        if tick() - lastTrigger >= _G.TriggerBotDelay then
            if _G.LockedTarget and _G.LockedTarget.Character then
                triggerBotParams.FilterDescendantsInstances = {player.Character, camera}
                
                local rayOrigin = camera.CFrame.Position
                local rayDirection = mouse.UnitRay.Direction * 1000
                local rayResult = workspace:Raycast(rayOrigin, rayDirection, triggerBotParams)
                
                if rayResult and rayResult.Instance then
                    local hitPart = rayResult.Instance
                    local hitModel = hitPart:FindFirstAncestorOfClass("Model")
                    
                    if hitModel == _G.LockedTarget.Character and hitModel:FindFirstChild("Humanoid") and hitModel.Humanoid.Health > _G.TriggerBotHpThreshold then
                        local pTarget = Players:GetPlayerFromCharacter(hitModel)
                        
                        if pTarget and pTarget ~= player then
                            local isTeammate = false
