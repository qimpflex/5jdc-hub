local function ExecuteConsole()
    local code = ConsoleInput.Text
    if code == "" then return end
    
    if code:sub(-1) == "\n" then
        code = code:sub(1, -2)
    end
    
    if code:lower() == "clear" or code:lower() == "cls" then
        for _, v in pairs(OutputScroll:GetChildren()) do
            if v:IsA("TextLabel") then v:Destroy() end
        end
        ConsoleInput.Text = ""
        return
    end
    ConsolePrint(code, COLORS.WHITE)
    ConsoleInput.Text = ""
    HideAutoComplete()
    
    local func, err = loadstring(code)
    if func then
        local success, runErr = pcall(func)
        if not success then
            ConsolePrint("Error: " .. tostring(runErr), COLORS.HEALTH_LOW)
        else
            ConsolePrint("Success", COLORS.HEALTH_HIGH)
        end
    else
        ConsolePrint("Syntax Error: " .. tostring(err), COLORS.HEALTH_LOW)
    end
end

RegisterConnection(ExecBtn.MouseButton1Click:Connect(ExecuteConsole))

local isShiftDown = false
RegisterConnection(UserInputService.InputBegan:Connect(function(input, gpe)
    if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
        isShiftDown = true
    elseif input.KeyCode == Enum.KeyCode.Tab and ConsoleInput:IsFocused() and AutoCompleteFrame.Visible and selectedMatch then
        task.delay(0.01, function()
            local txt = ConsoleInput.Text
            local cursorPos = ConsoleInput.CursorPosition
            if cursorPos > #txt + 1 then cursorPos = #txt + 1 end
            local textBeforeCursor = string.sub(txt, 1, cursorPos - 1)
            local lastWord = string.match(textBeforeCursor, "[%a_][%w_]*$")
            
            if lastWord then
                local newText = string.sub(txt, 1, cursorPos - 1 - #lastWord) .. selectedMatch .. string.sub(txt, cursorPos)
                ConsoleInput.Text = newText
                HideAutoComplete()
                ConsoleInput:CaptureFocus()
                ConsoleInput.CursorPosition = cursorPos - #lastWord + #selectedMatch + 1
            end
        end)
    elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
        if ConsoleInput:IsFocused() then
            if not isShiftDown then
                task.defer(function()
                    ExecuteConsole()
                    ConsoleInput:ReleaseFocus()
                end)
            end
        end
    end
end))

RegisterConnection(UserInputService.InputEnded:Connect(function(input, gpe)
    if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
        isShiftDown = false
    end
end))

RegisterConnection(ConsoleInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        if not isShiftDown then
            ExecuteConsole()
        end
    else
        task.delay(0.2, HideAutoComplete)
    end
end))



local ConfigSection = CreateSection(ScriptCol2, "Config Manager")

local CurrentConfigName = ""
local SelectedDropdownConfig = ""

local function EnsureConfigFolder()
    if isfolder and makefolder then
        if not isfolder("QimpflexData") then pcall(function() makefolder("QimpflexData") end) end
        if not isfolder("QimpflexData/Configs") then pcall(function() makefolder("QimpflexData/Configs") end) end
    end
end

local function GetAvailableConfigs()
    EnsureConfigFolder()
    local list = {}
    if listfiles and isfolder then
        local success, files = pcall(function() return listfiles("QimpflexData/Configs") end)
        if success and files then
            for _, file in ipairs(files) do
                local name = file:match("([^/\\]+)%.json$")
                if name then table.insert(list, {Name = name, Value = name}) end
            end
        end
    end
    if #list == 0 then table.insert(list, {Name = "No Configs Found", Value = ""}) end
    return list
end

