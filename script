local function isVisible(targetPart)
    local myChar = player.Character
    if not myChar or not myChar:FindFirstChild("Head") then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {myChar, camera}
    local result = workspace:Raycast(camera.CFrame.Position, (targetPart.Position - camera.CFrame.Position), params)
    return not result or result.Instance:IsDescendantOf(targetPart.Parent)
end

local function GetTargetFOV()
    local target, closestDist = nil, _G.SilentAimFOV
    local mousePos = UserInputService:GetMouseLocation()
    
    local hasOnlyAim = false
    for _, v in pairs(_G.OnlyAimPlayers) do if v then hasOnlyAim = true break end end

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            if not hasOnlyAim or _G.OnlyAimPlayers[v.UserId] then
                if not _G.TrustedPlayers[v.UserId] then
                    if not (_G.TeamCheck and v.Team == player.Team) then
                        local root = GetTargetPart(v.Character)
                        if root then
                            local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                            if onScreen and (not _G.VisibleCheck or isVisible(root)) then
                                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                                if dist < closestDist then closestDist = dist; target = v end
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

local function ValidateTarget(target)
    if not target or not target.Parent then return false end
    if not target.Character or not target.Character.Parent then return false end
    local hum = target.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local root = GetTargetPart(target.Character)
    if not root then return false end
    if _G.VisibleCheck and not isVisible(root) then return false end
    if _G.TeamCheck and target.Team == player.Team then return false end
    if _G.TrustedPlayers[target.UserId] then return false end
    
    local hasOnlyAim = false
    for _, v in pairs(_G.OnlyAimPlayers) do if v then hasOnlyAim = true break end end
    if hasOnlyAim and not _G.OnlyAimPlayers[target.UserId] then return false end
    
    return true
end

