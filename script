-- [ESP SİSTEMİ & TRACERS (OPTIMIZED MEMORY)]
-- ==========================================
local ESP_FOLDER = Instance.new("Folder", ScreenGui)
ESP_FOLDER.Name = HttpService:GenerateGUID(false)

function RefreshAllESP()
    ESP_FOLDER:ClearAllChildren()
    if _G.ESP_Enabled then
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= player and v.Character then
                CreateESP(v)
            end
        end
    end
end

local function UpdateTracers()
    local originX, originY = camera.ViewportSize.X / 2, camera.ViewportSize.Y
    local opt = TracerOriginOptions[_G.TracerOriginIndex].Value
    if opt == "Center" then
        originY = camera.ViewportSize.Y / 2
    elseif opt == "Mouse" then
        local mLoc = UserInputService:GetMouseLocation()
        originX, originY = mLoc.X, mLoc.Y
    end

    local hasOnlyESP = false
    for _, v in pairs(_G.OnlyESPPlayers) do if v then hasOnlyESP = true break end end

    for userId, tracer in pairs(getgenv().QimpTracers) do
        local targetPlayer = Players:GetPlayerByUserId(userId)
        local shouldDraw = true
        
        if hasOnlyESP and not _G.OnlyESPPlayers[userId] then
            shouldDraw = false
        end
        
        if shouldDraw and _G.ESP_Enabled and _G.ESP_Tracers and targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and targetPlayer.Character:FindFirstChild("Humanoid") and targetPlayer.Character.Humanoid.Health > 0 then
            if _G.TeamCheck and targetPlayer.Team == player.Team then
                tracer.Visible = false
            else
                local vector, onScreen = camera:WorldToViewportPoint(targetPlayer.Character.HumanoidRootPart.Position)
                if onScreen then
                    tracer.From = Vector2.new(originX, originY)
                    tracer.To = Vector2.new(vector.X, vector.Y)
                    tracer.Color = _G.ESP_Tracer_Color
                    tracer.Visible = true
                else
                    tracer.Visible = false
                end
            end
        else
            tracer.Visible = false
        end
    end
end

RegisterConnection(RunService.RenderStepped:Connect(UpdateTracers))

local function GetHealthColor(health, maxHealth)
    local percentage = math.clamp(health / maxHealth, 0, 1)
    if percentage > 0.6 then return COLORS.HEALTH_HIGH
    elseif percentage > 0.3 then return COLORS.HEALTH_MID
    else return COLORS.HEALTH_LOW end
end

function CreateESP(p)
    if p == player then return end
    
    if not getgenv().QimpTracers[p.UserId] then
        local tracerLine = Drawing.new("Line")
        tracerLine.Visible = false
        tracerLine.Color = _G.ESP_Tracer_Color or COLORS.ACCENT
        tracerLine.Thickness = 1.5
        tracerLine.Transparency = 0.8
        getgenv().QimpTracers[p.UserId] = tracerLine
    end

    local function ApplyESP(char)
        if not _G.ESP_Enabled then return end
        if _G.TeamCheck and p.Team == player.Team then return end
        
        local hasOnlyESP = false
        for _, v in pairs(_G.OnlyESPPlayers) do if v then hasOnlyESP = true break end end
        if hasOnlyESP and not _G.OnlyESPPlayers[p.UserId] then 
            CleanPlayerConnections(p.UserId)
            for _, v in pairs(ESP_FOLDER:GetChildren()) do
                if v:GetAttribute("Target") == p.UserId then v:Destroy() end
            end
            return 
        end

        CleanPlayerConnections(p.UserId)
        
        for _, v in pairs(ESP_FOLDER:GetChildren()) do
            if v:GetAttribute("Target") == p.UserId then v:Destroy() end
        end

        if _G.ESP_Highlight then
            local Highlight = Instance.new("Highlight")
            Highlight.Name = HttpService:GenerateGUID(false)
            Highlight.Adornee = char
            Highlight.FillTransparency = 0.5
            Highlight.FillColor = _G.ESP_Highlight_Color
            Highlight.OutlineColor = COLORS.WHITE
            Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            Highlight.Parent = ESP_FOLDER
            Highlight:SetAttribute("Target", p.UserId)
        end

        if _G.ESP_Name or _G.ESP_Thumbnail or _G.ESP_HealthBar or _G.ESP_Distance then
            local torso = char:WaitForChild("HumanoidRootPart", 5)
            if not torso then return end

            local Billboard = Instance.new("BillboardGui")
            Billboard.Name = HttpService:GenerateGUID(false)
            Billboard.Adornee = torso
            Billboard.Size = UDim2.new(0, 120, 0, 40)
            Billboard.StudsOffset = Vector3.new(0, -4.5, 0)
            Billboard.AlwaysOnTop = true
            Billboard.Parent = ESP_FOLDER
            Billboard:SetAttribute("Target", p.UserId)

            local Container = Instance.new("Frame")
            Container.Size = UDim2.new(1, 0, 1, 0)
            Container.BackgroundTransparency = 1
            Container.BorderSizePixel = 0
            Container.Parent = Billboard

            local textOffset = 0

            if _G.ESP_HealthBar then
                local hpBG = Instance.new("Frame")
                hpBG.Size = UDim2.new(0, 4, 1, -10)
                hpBG.Position = UDim2.new(0, 0, 0, 5)
                hpBG.BackgroundColor3 = COLORS.DARK_GRAY
                hpBG.BorderSizePixel = 0
                hpBG.Parent = Container
                local hpStr = Instance.new("UIStroke", hpBG)
                hpStr.Color = COLORS.SECTION_STROKE
                hpStr.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

                local hpFill = Instance.new("Frame")
                hpFill.Size = UDim2.new(1, 0, 1, 0)
                hpFill.Position = UDim2.new(0, 0, 0, 0)
                hpFill.BackgroundColor3 = COLORS.HEALTH_HIGH
                hpFill.BorderSizePixel = 0
                hpFill.Parent = hpBG

                textOffset = textOffset + 8
                
                RegisterPlayerConnection(p.UserId, RunService.Heartbeat:Connect(function()
                    if char and char:FindFirstChild("Humanoid") and hpFill.Parent then
                        local hum = char.Humanoid
                        local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        hpFill.Size = UDim2.new(1, 0, hpPct, 0)
                        hpFill.Position = UDim2.new(0, 0, 1 - hpPct, 0)
                        hpFill.BackgroundColor3 = GetHealthColor(hum.Health, hum.MaxHealth)
                    end
                end))
            end

            if _G.ESP_Thumbnail then
                local pImg = Instance.new("ImageLabel")
                pImg.Size = UDim2.new(0, 28, 0, 28)
