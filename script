local function set_hrp_state(plr, is_active)
    pcall(function()
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            if is_active then
                hrp.Size = Vector3.new(hb_config.size, hb_config.size, hb_config.size)
                hrp.Transparency = hb_config.transparency
                hrp.BrickColor = hb_config.color
                hrp.Material = hb_config.material
                hrp.CanCollide = hb_config.cancollide
            else
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
                hrp.BrickColor = BrickColor.new("Medium stone grey")
                hrp.Material = Enum.Material.Plastic
                hrp.CanCollide = true
            end
        end
    end)
end

local function update_all_hitboxes()
    if hb_config.enabled then
        for _, p in pairs(Players:GetPlayers()) do
            set_hrp_state(p, true)
        end
    end
end

local original_transparencies = {}
local function update_ghost_mode(state)
    if not player.Character then return end
    for _, part in pairs(player.Character:GetDescendants()) do 
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then 
            if state then
                if original_transparencies[part] == nil then
                    original_transparencies[part] = part.Transparency
                end
                part.Transparency = 0.9 
            else
                if original_transparencies[part] ~= nil then
                    part.Transparency = original_transparencies[part]
                end
            end
        end 
    end
end

