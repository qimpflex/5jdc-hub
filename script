    Label.Font = Enum.Font.Arcade
    Label.TextSize = 10
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Section

    local BindBtn = Instance.new("TextButton")
    BindBtn.Size = UDim2.new(0, 50, 0, 18)
    BindBtn.Position = UDim2.new(1, -50, 0.5, -9)
    BindBtn.BackgroundColor3 = COLORS.DARK_GRAY
    BindBtn.BorderSizePixel = 0
    BindBtn.Font = Enum.Font.Arcade
    BindBtn.TextSize = 10
    BindBtn.TextColor3 = COLORS.ACCENT
    BindBtn.Parent = Section
    ApplyMatteVFX(BindBtn, false)

    local function formatKeyName(k)
        if not k then return "NONE" end
        local kName = k.Name
        if k == Enum.UserInputType.MouseButton1 then return "MB1" end
        if k == Enum.UserInputType.MouseButton2 then return "MB2" end
        if k == Enum.UserInputType.MouseButton3 then return "MB3" end
        return kName
    end

    BindBtn.Text = "[" .. formatKeyName(defaultKey) .. "]"

    local stroke = Instance.new("UIStroke", BindBtn)
    stroke.Color = COLORS.STROKE
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    AddHoverAnimation(BindBtn, COLORS.HOVER, COLORS.DARK_GRAY)

    local isBinding = false
    RegisterConnection(BindBtn.MouseButton1Click:Connect(function()
        PlayClick()
        isBinding = true
        BindBtn.Text = "[...]"
        BindBtn.TextColor3 = COLORS.WHITE
    end))

    RegisterConnection(UserInputService.InputBegan:Connect(function(input, gpe)
        if isBinding then
            local key = input.KeyCode == Enum.KeyCode.Unknown and input.UserInputType or input.KeyCode
            if key == Enum.UserInputType.MouseMovement or key == Enum.UserInputType.Focus then return end
            
            isBinding = false
            BindBtn.Text = "[" .. formatKeyName(key) .. "]"
            BindBtn.TextColor3 = COLORS.ACCENT
            callback(key)
        end
    end))

    local KeybindController = {}
    function KeybindController:Set(newKey)
        BindBtn.Text = "[" .. formatKeyName(newKey) .. "]"
        callback(newKey)
    end
    return KeybindController
end

