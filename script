    RegisterConnection(ValueButton.MouseLeave:Connect(function()
        TweenService:Create(ValueBG, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {BackgroundColor3 = COLORS.DARK_GRAY}):Play()
    end))

    local SliderBG = Instance.new("TextButton")
    SliderBG.Size = UDim2.new(1, -6, 0, 6)
    SliderBG.Position = UDim2.new(0, 3, 0, 28)
    SliderBG.BackgroundColor3 = COLORS.DARK_GRAY
    SliderBG.BorderSizePixel = 0
    SliderBG.Text = ""
    SliderBG.AutoButtonColor = false
    SliderBG.Parent = Section
    ApplyMatteVFX(SliderBG, false)

    local Stroke = Instance.new("UIStroke", SliderBG)
    Stroke.Color = COLORS.STROKE
    Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local SliderFill = Instance.new("Frame")
    local fillPercentage = (default - min) / (max - min)
    SliderFill.Size = UDim2.new(fillPercentage, 0, 1, 0)
    SliderFill.BackgroundColor3 = Color3.new(1,1,1)
    SliderFill.BorderSizePixel = 0
    SliderFill.Parent = SliderBG

    local fillGrad = Instance.new("UIGradient")
    fillGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, COLORS.ACCENT_DARK),
        ColorSequenceKeypoint.new(1, COLORS.ACCENT)
    })
    fillGrad.Rotation = 0
    fillGrad.Parent = SliderFill

    local dragging = false
    
    local function UpdateVisuals(value)
        local percentage = math.clamp((value - min) / (max - min), 0, 1)
        TweenService:Create(SliderFill, TweenInfo.new(0.05, Enum.EasingStyle.Sine), {Size = UDim2.new(percentage, 0, 1, 0)}):Play()
        ValueLabel.Text = tostring(value)
        callback(value)
    end

    local function UpdateSliderFromMouse()
        local mousePos = UserInputService:GetMouseLocation().X
        local bgPos = SliderBG.AbsolutePosition.X
        local bgSize = SliderBG.AbsoluteSize.X
        local percentage = math.clamp((mousePos - bgPos) / bgSize, 0, 1)
        currentValue = math.floor(min + ((max - min) * percentage))
        UpdateVisuals(currentValue)
    end

    RegisterConnection(ValueButton.MouseButton1Click:Connect(function()
        ValueLabel.Visible = false
        ValueButton.Visible = false
        InputBox.Visible = true
        InputBox.Text = tostring(currentValue)
        InputBox:CaptureFocus()
    end))

    RegisterConnection(InputBox.FocusLost:Connect(function()
        local rawText = string.lower(InputBox.Text)
        local parsedValue = nil

        if string.find(rawText, "k") then
            local num = tonumber(string.gsub(rawText, "k", ""))
            if num then parsedValue = num * 1000 end
        elseif string.find(rawText, "m") then
            local num = tonumber(string.gsub(rawText, "m", ""))
            if num then parsedValue = num * 1000000 end
        else
            parsedValue = tonumber(rawText)
        end

        if parsedValue then
            currentValue = math.floor(math.clamp(parsedValue, min, max))
            UpdateVisuals(currentValue)
        end

        InputBox.Visible = false
        ValueLabel.Visible = true
        ValueButton.Visible = true
    end))

    RegisterConnection(SliderBG.MouseButton1Down:Connect(function()
        preventDrag = true
        dragging = true
        UpdateSliderFromMouse()
    end))

    RegisterConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            preventDrag = false
            dragging = false
        end
    end))

    RegisterConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSliderFromMouse()
        end
    end))

    local SliderController = {}
    function SliderController:Set(value)
        currentValue = math.clamp(value, min, max)
        UpdateVisuals(currentValue)
    end
    return SliderController
end

