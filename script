local TARGET_AMMO_VALUE = 25
local infiniteAmmoConnections = {}

local function enforceValue(instance, targetValue, isCooldown)
    if instance and instance:IsA("ValueBase") then
        if instance.Value ~= targetValue then
            instance.Value = targetValue
        end
        
        if not infiniteAmmoConnections[instance] then
            infiniteAmmoConnections[instance] = RegisterConnection(instance:GetPropertyChangedSignal("Value"):Connect(function()
                if isCooldown then
                    if _G.BulletCooldownEnabled and instance.Value > targetValue then
                        instance.Value = targetValue
                    end
                else
                    if _G.InfiniteAmmo and instance.Value < targetValue then
                        instance.Value = targetValue
                    end
                end
            end))
        end
    end
end

local function applyWeaponModifications(tool)
    if not tool:IsA("Tool") then return end

    local ammo = tool:FindFirstChild("Ammo")
    local maxAmmo = tool:FindFirstChild("MaxAmmo")
    local cooldown = tool:FindFirstChild("ShootingCooldown")

    if _G.InfiniteAmmo then
        if ammo then enforceValue(ammo, TARGET_AMMO_VALUE, false) end
        if maxAmmo then enforceValue(maxAmmo, TARGET_AMMO_VALUE, false) end
    end
    if _G.BulletCooldownEnabled then
        if cooldown then enforceValue(cooldown, _G.BulletCooldownValue, true) end
    end
end

local function scanAndListenContainer(container)
    if not container then return end
    
    for _, item in ipairs(container:GetChildren()) do
        applyWeaponModifications(item)
    end
    
    if not infiniteAmmoConnections[container] then
        infiniteAmmoConnections[container] = RegisterConnection(container.ChildAdded:Connect(function(child)
            applyWeaponModifications(child)
        end))
    end
end

local function setupCharacter(character)
    if not character then return end
    scanAndListenContainer(character)
end

