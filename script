local function GetTargetPart(char)
    if not char then return nil end
    local opt = TargetPartOptions[_G.TargetPartIndex].Value
    if opt == "Random" then
        local parts = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso"}
        local valid = {}
        for _, p in ipairs(parts) do
            if char:FindFirstChild(p) then table.insert(valid, char[p]) end
        end
        if #valid > 0 then return valid[math.random(1, #valid)] end
        return char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild(opt) or char:FindFirstChild("HumanoidRootPart")
    end
end

local function CheckPlayerForBlacklistedGroups(plr)
    if isAdminKicking or plr == player then return end 
    task.spawn(function()
        for _, groupId in ipairs(BLACKLISTED_GROUP_IDS) do
            if isAdminKicking then break end 
            local success, isInGroup = pcall(function()
                return plr:IsInGroup(groupId)
            end)
            if success and isInGroup then
                if not isAdminKicking then
                    isAdminKicking = true
                    local kickMessage = string.format("\n[5JDC Security]\n%s The player named is in the banned admin/mod group (ID: %d) The user was logged out from the server for security reasons.", plr.Name, groupId)
                    player:Kick(kickMessage)
                end
                break 
            elseif not success then
                warn(string.format("[5JDC Security] %s adlı oyuncu için %d grubu kontrol edilirken ağ hatası oluştu.", plr.Name, groupId))
            end
        end
    end)
end

local function GetLightingEffect(className, name)
    local effect = Lighting:FindFirstChild(name)
    if not effect then
        effect = Instance.new(className)
        effect.Name = name
        effect.Parent = Lighting
    end
    return effect
end

