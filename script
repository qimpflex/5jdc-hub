local currentSuggestions = {}
local selectedMatch = nil

local function HideAutoComplete()
    AutoCompleteFrame.Visible = false
    selectedMatch = nil
    for _, child in pairs(AutoCompleteFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
end

local function UpdateAutoComplete()
    local txt = ConsoleInput.Text
    local cursorPos = ConsoleInput.CursorPosition
    if cursorPos > #txt + 1 then cursorPos = #txt + 1 end
    local textBeforeCursor = string.sub(txt, 1, cursorPos - 1)
    local lastWord = string.match(textBeforeCursor, "[%a_][%w_]*$")

    if not lastWord or #lastWord < 1 then
        HideAutoComplete()
        return
    end

    currentSuggestions = {}
    local lowerWord = string.lower(lastWord)
    for _, kw in ipairs(LuauKeywords) do
        if string.sub(string.lower(kw), 1, #lowerWord) == lowerWord then
            table.insert(currentSuggestions, kw)
        end
    end

    if #currentSuggestions == 0 then
        HideAutoComplete()
        return
    end

    HideAutoComplete()
    AutoCompleteFrame.Visible = true
    selectedMatch = currentSuggestions[1]

    for i, sugg in ipairs(currentSuggestions) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 18)
        btn.BackgroundColor3 = i == 1 and COLORS.HOVER or COLORS.SIDE
        btn.Text = "  " .. sugg
        btn.TextColor3 = i == 1 and COLORS.WHITE or COLORS.GRAY
        btn.Font = Enum.Font.Code
        btn.TextSize = 10
        btn.BorderSizePixel = 0
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.ZIndex = 51
        btn.Parent = AutoCompleteFrame

        RegisterConnection(btn.MouseButton1Click:Connect(function()
            local newText = string.sub(txt, 1, cursorPos - 1 - #lastWord) .. sugg .. string.sub(txt, cursorPos)
            ConsoleInput.Text = newText
            HideAutoComplete()
            task.wait()
            ConsoleInput:CaptureFocus()
            ConsoleInput.CursorPosition = cursorPos - #lastWord + #sugg + 1
        end))
    end

    local contentHeight = math.clamp(#currentSuggestions * 19, 0, 80)
    AutoCompleteFrame.Size = UDim2.new(1, -55, 0, contentHeight)
    AutoCompleteFrame.Position = UDim2.new(0, 5, 0, -contentHeight - 2)
    AutoCompleteFrame.CanvasSize = UDim2.new(0, 0, 0, #currentSuggestions * 19)
end

