    btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    
    local Arrow = Instance.new("TextLabel")
    Arrow.Size = UDim2.new(0, 20, 1, 0)
    Arrow.Position = UDim2.new(1, -25, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "▼"
    Arrow.TextColor3 = COLORS.ACCENT
    Arrow.Font = Enum.Font.Arcade
    Arrow.TextSize = 12
    Arrow.ZIndex = 3
    Arrow.Parent = Btn

    local DropdownFrame = Instance.new("ScrollingFrame")
    DropdownFrame.Size = UDim2.new(1, 0, 0, 100)
    DropdownFrame.AnchorPoint = Vector2.new(0, 1)
    DropdownFrame.Position = UDim2.new(0, 0, 0, -2)
    DropdownFrame.BackgroundColor3 = COLORS.DARK_GRAY
    DropdownFrame.BorderSizePixel = 0
    DropdownFrame.ZIndex = 100
    DropdownFrame.ScrollBarThickness = 2
    DropdownFrame.ScrollBarImageColor3 = COLORS.ACCENT
    DropdownFrame.Visible = false
    DropdownFrame.Parent = Btn
    ApplyMatteVFX(DropdownFrame, false)
    
    local dropStroke = Instance.new("UIStroke", DropdownFrame)
    dropStroke.Color = COLORS.STROKE
    dropStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local Layout = Instance.new("UIListLayout", DropdownFrame)
    Layout.Padding = UDim.new(0, 2)

    local isOpen = false
    local closeEvent

    local function CloseDropdown()
        if not isOpen then return end
        isOpen = false
        DropdownFrame.Visible = false
        Wrapper.ZIndex = 1
        Btn.ZIndex = 2
        Arrow.Text = "▼"
        if closeEvent then closeEvent:Disconnect(); closeEvent = nil end
    end

    local function populate(opts)
        for _, child in pairs(DropdownFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        
        for i, opt in ipairs(opts) do
            local OptBtn = Instance.new("TextButton")
            OptBtn.Size = UDim2.new(1, -4, 0, 20)
            OptBtn.BackgroundColor3 = COLORS.SIDE
            OptBtn.Text = "  " .. opt.Name
            OptBtn.TextColor3 = COLORS.GRAY
            OptBtn.Font = Enum.Font.Arcade
            OptBtn.TextSize = 10
            OptBtn.BorderSizePixel = 0
            OptBtn.TextXAlignment = Enum.TextXAlignment.Left
            OptBtn.ZIndex = 101
            OptBtn.Parent = DropdownFrame

            RegisterConnection(OptBtn.MouseEnter:Connect(function()
                OptBtn.BackgroundColor3 = COLORS.HOVER
                OptBtn.TextColor3 = COLORS.WHITE
            end))
            RegisterConnection(OptBtn.MouseLeave:Connect(function()
                OptBtn.BackgroundColor3 = COLORS.SIDE
                OptBtn.TextColor3 = COLORS.GRAY
            end))

            RegisterConnection(OptBtn.MouseButton1Click:Connect(function()
                Btn.Text = " " .. text .. ": " .. opt.Name
                callback(opt.Value, i)
                CloseDropdown()
            end))
        end
        local height = math.clamp(Layout.AbsoluteContentSize.Y, 0, 100)
        DropdownFrame.Size = UDim2.new(1, 0, 0, height)
        DropdownFrame.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y)
    end
    populate(options)

    RegisterConnection(Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        local height = math.clamp(Layout.AbsoluteContentSize.Y, 0, 100)
        DropdownFrame.Size = UDim2.new(1, 0, 0, height)
        DropdownFrame.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y)
    end))

    RegisterConnection(Btn.MouseButton1Click:Connect(function()
        PlayClick()
        if isOpen then
            CloseDropdown()
        else
            isOpen = true
            DropdownFrame.Visible = true
            Wrapper.ZIndex = 50 
            Btn.ZIndex = 51
            Arrow.Text = "▲"
            
            task.wait()
            closeEvent = RegisterConnection(UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local mx, my = mouse.X, mouse.Y
                    local dAbsPos = DropdownFrame.AbsolutePosition
                    local dAbsSize = DropdownFrame.AbsoluteSize
                    local bAbsPos = Btn.AbsolutePosition
                    local bAbsSize = Btn.AbsoluteSize

                    local inDrop = mx >= dAbsPos.X and mx <= dAbsPos.X + dAbsSize.X and my >= dAbsPos.Y and my <= dAbsPos.Y + dAbsSize.Y
                    local inBtn = mx >= bAbsPos.X and mx <= bAbsPos.X + bAbsSize.X and my >= bAbsPos.Y and my <= bAbsPos.Y + bAbsSize.Y

                    if not (inDrop or inBtn) then
                        CloseDropdown()
                    end
                end
            end))
        end
    end))
    
    local controller = {}
    function controller:Set(index)
        if options[index] then
            Btn.Text = " " .. text .. ": " .. options[index].Name
            callback(options[index].Value, index)
        end
    end
    function controller:UpdateOptions(newOptions, defaultIndex)
        options = newOptions
        populate(options)
        local dIdx = defaultIndex or 1
        if options[dIdx] then
            Btn.Text = " " .. text .. ": " .. options[dIdx].Name
            callback(options[dIdx].Value, dIdx)
        else
            Btn.Text = " " .. text .. ": NONE"
            callback("", 0)
        end
    end
    return controller
end

