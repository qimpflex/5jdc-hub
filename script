local LuauKeywordsMap = {}
for _, v in ipairs({"and", "break", "continue", "do", "else", "elseif", "end", "false", "for", "function", "if", "in", "local", "nil", "not", "or", "repeat", "return", "then", "true", "until", "while"}) do LuauKeywordsMap[v] = true end

local LuauGlobalsMap = {}
for _, v in ipairs({"game", "workspace", "script", "math", "string", "table", "print", "warn", "error", "task", "coroutine", "os", "debug", "Vector3", "Vector2", "CFrame", "Color3", "UDim2", "UDim", "Instance", "RaycastParams", "TweenInfo", "Enum", "Ray", "require", "tostring", "tonumber", "typeof", "type", "pairs", "ipairs", "next", "unpack", "setmetatable", "getmetatable"}) do LuauGlobalsMap[v] = true end

local function getColoredText(text)
    local colored = ""
    local i = 1
    while i <= #text do
        local char = text:sub(i, i)
        if text:sub(i, i+1) == "--" then
            local endPos = text:find("\n", i) or (#text + 1)
            local comment = text:sub(i, endPos - 1)
            colored = colored .. '<font color="#666666">' .. comment:gsub("<","&lt;"):gsub(">","&gt;") .. '</font>'
            i = endPos
        elseif char == '"' or char == "'" then
            local endPos = text:find(char, i + 1) or (#text + 1)
            local str = text:sub(i, endPos)
            colored = colored .. '<font color="#adf195">' .. str:gsub("<","&lt;"):gsub(">","&gt;") .. '</font>'
            i = endPos + 1
        elseif char:match("%d") then
            local numStart = i
            while i <= #text and text:sub(i, i):match("[%d%.]") do i = i + 1 end
            colored = colored .. '<font color="#ffc600">' .. text:sub(numStart, i - 1) .. '</font>'
        elseif char:match("[%w_]") then
            local wordStart = i
            while i <= #text and text:sub(i, i):match("[%w_]") do i = i + 1 end
            local word = text:sub(wordStart, i - 1)
            if LuauKeywordsMap[word] then
                colored = colored .. '<font color="#f86d7c">' .. word .. '</font>'
            elseif LuauGlobalsMap[word] then
                colored = colored .. '<font color="#84d6f7">' .. word .. '</font>'
            else
                colored = colored .. word
            end
        else
            colored = colored .. (char == "<" and "&lt;" or char == ">" and "&gt;" or char == "&" and "&amp;" or char)
            i = i + 1
        end
    end
    return colored
end

local LuauKeywords = {
