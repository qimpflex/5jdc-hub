local function setStatus(msg, color)
    statusLabel.Text       = msg
    statusLabel.TextColor3 = color or Color3.fromRGB(80, 80, 80)
end

local function closeUI()
    TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {
        Position = UDim2.new(0.5, 0, 1.5, 0)
    }):Play()
    TweenService:Create(overlay, TweenInfo.new(0.3), {
        BackgroundTransparency = 1
    }):Play()
    task.delay(0.35, function() screenGui:Destroy() end)
end

local function startBlacklistLoop()
    task.spawn(function()
        while task.wait(CONFIG.CHECK_INTERVAL) do
            local data = fetchData()
            if data and data.blacklist then
                for _, id in ipairs(data.blacklist) do
                    if tostring(id) == UserId then
                        kickPlayer(CONFIG.BLACKLIST_MSG)
                        return
                    end
                end
            end
        end
    end)
end

-- ══════════════════════════════════════════
--  KEY DOĞRULAMA
-- ══════════════════════════════════════════

local isChecking = false

local function validateKey()
    if isChecking then return end
    local key = textBox.Text:gsub("%s", ""):upper()

    if key == "" then
        setStatus("⚠ Bir anahtar gir.", Color3.fromRGB(160, 130, 50))
        return
    end

    isChecking = true
    setStatus("Doğrulanıyor...", Color3.fromRGB(80, 80, 120))

    task.spawn(function()
        local data = fetchData()

        if not data then
            setStatus("⚠ Sunucuya ulaşılamadı.", Color3.fromRGB(160, 60, 60))
            isChecking = false
            return
        end

        if data.blacklist then
            for _, id in ipairs(data.blacklist) do
                if tostring(id) == UserId then
                    setStatus(CONFIG.BLACKLIST_MSG, Color3.fromRGB(160, 50, 50))
                    task.delay(1.5, function() kickPlayer(CONFIG.BLACKLIST_MSG) end)
                    return
                end
            end
        end

        if data.keys then
            for _, validKey in ipairs(data.keys) do
                if validKey:upper() == key then
                    setStatus("✓ Erişim verildi.", Color3.fromRGB(60, 160, 90))
                    task.delay(0.8, function()
                        closeUI()
                        task.delay(0.4, okgiris)
                        startBlacklistLoop()
                    end)
                    return
                end
            end
        end

        setStatus(CONFIG.WRONG_KEY_MSG, Color3.fromRGB(160, 60, 60))
        TweenService:Create(inputStroke, TweenInfo.new(0.1), {
            Color = Color3.fromRGB(140, 40, 40)
        }):Play()
        task.delay(1, function()
            TweenService:Create(inputStroke, TweenInfo.new(0.2), {
                Color = Color3.fromRGB(35, 35, 35)
            }):Play()
        end)
        isChecking = false
    end)
end

btn.MouseButton1Click:Connect(validateKey)
textBox.FocusLost:Connect(function(enter)
    if enter then validateKey() end
end)

