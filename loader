-- ──────────────────────────────────────────
-- Blacklist polling loop (30s)
-- ──────────────────────────────────────────
local function startBlacklistLoop()
    task.spawn(function()
        while task.wait(CONFIG.CHECK_INTERVAL) do
            local data = fetchData()
            if data and data.blacklist then
                for _, id in ipairs(data.blacklist) do
                    if tostring(id) == UserId then
                        kickPlayer(CONFIG.BLACKLIST_MSG)
                        return
                    end
                end
            end
        end
    end)
end

-- ──────────────────────────────────────────
-- Anahtar doğrulama
-- ──────────────────────────────────────────
local function validateKey()
    local key = textBox.Text:gsub("%s", ""):upper()
    if key == "" then
        setStatus("⚠ Bir anahtar gir.", Color3.fromRGB(200, 160, 60))
        return
    end

    setStatus("⏳ Doğrulanıyor...", Color3.fromRGB(100, 100, 180))
    btn.Active = false

    task.spawn(function()
        local data = fetchData()

        if not data then
            setStatus("⚠ Sunucuya ulaşılamadı.", Color3.fromRGB(200, 80, 80))
            btn.Active = true
            return
        end

        -- Önce blacklist kontrolü
        if data.blacklist then
            for _, id in ipairs(data.blacklist) do
                if tostring(id) == UserId then
                    setStatus(CONFIG.BLACKLIST_MSG, Color3.fromRGB(200, 60, 60))
                    task.delay(1.5, function() kickPlayer(CONFIG.BLACKLIST_MSG) end)
                    return
                end
            end
        end

        -- Key kontrolü
        if data.keys then
            for _, validKey in ipairs(data.keys) do
                if validKey:upper() == key then
                    setStatus("✅ Erişim verildi!", Color3.fromRGB(60, 200, 120))
                    task.delay(0.8, function()
                    okgiris()
                        closeUI()
                        startBlacklistLoop()
                    end)
                    return
                end
            end
        end

        -- Yanlış key
        setStatus(CONFIG.WRONG_KEY_MSG, Color3.fromRGB(200, 80, 80))
        TweenService:Create(inputStroke, TweenInfo.new(0.1), {
            Color = Color3.fromRGB(200, 60, 60)
        }):Play()
        task.delay(1, function()
            TweenService:Create(inputStroke, TweenInfo.new(0.2), {
                Color = Color3.fromRGB(40, 40, 55)
            }):Play()
        end)
        btn.Active = true
    end)
end

btn.MouseButton1Click:Connect(validateKey)
textBox.FocusLost:Connect(function(enter)
